<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warehouse_map_import_wizard_form" model="ir.ui.view">
        <field name="name">warehouse.map.import.wizard.form</field>
        <field name="model">warehouse.map.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar ubicaciones desde Excel">
                <group>
                    <field name="warehouse_id" required="1"/>
                    <field name="file" filename="filename" required="1"/>
                    <field name="filename" invisible="1"/>
                </group>
                <field name="log" nolabel="1" readonly="1" colspan="2"
                       invisible="state != 'result'"
                       widget="html"/>
                <footer>
                    <button name="action_import" string="Importar" type="object"
                            class="btn-primary"
                            invisible="state == 'result'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
