<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_warehouse_map" model="ir.actions.client">
        <field name="name">Mapa del Almacén</field>
        <field name="tag">warehouse_map</field>
        <field name="target">current</field>
    </record>

    <record id="action_open_warehouse_map_config" model="ir.actions.act_window">
        <field name="name">Configuración del Mapa</field>
        <field name="res_model">warehouse.map</field>
        <field name="view_mode">tree,form</field>
        <field name="help">Configure los racks y pasillos del mapa virtual del almacén.</field>
    </record>

    <record id="action_import_warehouse_locations" model="ir.actions.act_window">
        <field name="name">Importar ubicaciones (Excel)</field>
        <field name="res_model">warehouse.map.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_warehouse_map_group"
              name="Mapa Virtual"
              parent="stock.menu_stock_config_settings"
              sequence="3"/>

    <menuitem id="menu_warehouse_map"
              name="Ver Mapa Virtual"
              parent="menu_warehouse_map_group"
              sequence="1"
              action="action_warehouse_map"/>

    <menuitem id="menu_import_locations"
              name="Importar ubicaciones"
              parent="menu_warehouse_map_group"
              sequence="2"
              action="action_import_warehouse_locations"/>
</odoo>
